DATABASE_URL="postgresql://telemed_user:telemed_password@localhost:5432/telemedsecure?schema=public"
PORT=4000
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_REFRESH_SECRET="your_super_secret_refresh_key_here"
FRONTEND_URL="http://localhost:5173"

# --- Bootstrapping and demo affordances -----------------------------------
# Read by prisma/seed.ts and scripts/seed-demo.ts. Leave unset in local
# development; they matter when NODE_ENV=production.
# ADMIN_EMAIL / ADMIN_PASSWORD: identity created by `prisma db seed`. Seeding
# aborts in production when ADMIN_PASSWORD is unset rather than using the
# built-in "ChangeMe123!". The account is created with mustChangePassword.
ADMIN_EMAIL="admin@your-org.example"
ADMIN_PASSWORD=""
# SEED_DEMO_DATA=true: also create the "Password123!" demo roster. Refused by
# default on production because those credentials are published in README.md.
SEED_DEMO_DATA=""
# SEED_FORCE_RESET=true: let seed upserts rewrite credentials, re-activate
# suspended accounts and clear lockouts for rows that already exist. Recovery
# switch for a locked-out local admin only.
SEED_FORCE_RESET=""
# DEMO_LOGIN_ENABLED=true: keep POST /auth/quick-login (role name in, token out,
# no credential) reachable outside test/development. Never enable it in
# production; it returns 404 and logs DEMO_LOGIN_BLOCKED when disabled.
DEMO_LOGIN_ENABLED=""
